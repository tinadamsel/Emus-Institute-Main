@model Core.ViewModels.ApplicationUserViewModel

@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Views/Shared/_StaffDashboardLayout.cshtml";
    var greeting = DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };
}

<main id="main" class="main sa-dashboard-home">
    <section class="sa-hero" aria-label="Welcome">
        <div class="sa-hero-content">
            <p class="sa-hero-eyebrow">Academic Staff</p>
            <h1>@greeting, Tutor</h1>
            <p class="sa-hero-sub">Manage your referrals, credentials, and teaching resources in one workspace.</p>
        </div>
        <div class="sa-hero-meta">
            <p class="sa-hero-date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
            <p class="sa-hero-institute">Emus Institute</p>
        </div>
    </section>

    <section class="sa-stats-grid" aria-label="Key metrics">
        <a asp-controller="AcademicStaff" asp-action="Textbooks" class="sa-stat-card" data-accent="cyan">
            <p class="sa-stat-label">Department textbooks</p>
            <div class="sa-stat-row">
                <span class="sa-stat-icon"><i class="bi bi-book"></i></span>
                <p class="sa-stat-value">0</p>
            </div>
            <p class="sa-stat-hint">Learning resources</p>
        </a>

        <a asp-controller="AcademicStaff" asp-action="EvaluateCredentials" class="sa-stat-card" data-accent="amber">
            <p class="sa-stat-label">Credential evaluation</p>
            <div class="sa-stat-row">
                <span class="sa-stat-icon"><i class="bi bi-patch-check"></i></span>
                <p class="sa-stat-value">1</p>
            </div>
            <p class="sa-stat-hint">Complete compliance checks</p>
        </a>

        <a class="sa-stat-card sa-clickable" data-accent="teal" href="javascript:void(0)" onclick="ReferralLink()" title="Copy referral link">
            <p class="sa-stat-label">Referred students</p>
            <div class="sa-stat-row">
                <span class="sa-stat-icon"><i class="bi bi-people-fill"></i></span>
                <p class="sa-stat-value">@Model.TotalReferredStudents</p>
            </div>
            <p class="sa-stat-hint">Share your referral link</p>
        </a>

        <a class="sa-stat-card" data-accent="green">
            <p class="sa-stat-label">Referral earnings</p>
            <div class="sa-stat-row">
                <span class="sa-stat-icon"><i class="bi bi-cash-coin"></i></span>
                <p class="sa-stat-value">&pound;@Model.ReferralEarnings.ToString("0.00")</p>
            </div>
            <p class="sa-stat-hint">Earnings to date</p>
        </a>
    </section>
</main>
