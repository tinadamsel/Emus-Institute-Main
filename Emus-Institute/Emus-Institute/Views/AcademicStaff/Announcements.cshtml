@model IEnumerable<Core.ViewModels.AnnouncementViewModel>
@using Core.Models
@using static Core.DB.ECollegeEnums
@{
    ViewData["Title"] = "Announcements";
    Layout = "~/Views/Shared/_StaffDashboardLayout.cshtml";
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Announcements</h1>
            <p class="sa-page-sub">Create announcements for a department or all students.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="sa-list-card p-4">
                <h5 class="mb-3">Create Announcement</h5>
                <div class="mb-3">
                    <label class="form-label">Title <span class="text-danger">*</span></label>
                    <input type="text" id="announcement_Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Message <span class="text-danger">*</span></label>
                    <textarea id="announcement_Message" class="form-control" rows="5"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Audience</label>
                    <select id="announcement_Audience" class="form-control" onchange="toggleAnnouncementDepartment()">
                        <option value="@((int)AnnouncementAudience.Department)">Department</option>
                        <option value="@((int)AnnouncementAudience.WholeStudents)">Whole Students</option>
                    </select>
                </div>
                <div class="mb-3" id="announcement_department_wrap">
                    <label class="form-label">Department</label>
                    <select id="announcement_DepartmentId" class="form-control">
                        <option value="">-- Select Department --</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.Id">@department.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Start Date & Time</label>
                    <input type="datetime-local" id="announcement_Start" class="form-control" />
                </div>
                <div class="mb-4">
                    <label class="form-label">End Date & Time</label>
                    <input type="datetime-local" id="announcement_End" class="form-control" />
                </div>
                <button type="button" id="create_announcement_btn" class="btn btn-outline-success w-100" onclick="createAnnouncement()">
                    Create Announcement
                </button>
                <p class="small text-muted mt-3 mb-0">
                    Department announcements send email notifications to students in that department. Whole-student announcements are shown as a dashboard badge.
                </p>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="sa-list-card p-4">
                <h5 class="mb-3">Recent Announcements</h5>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="border rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">@item.Title</h6>
                                <span class="badge @(item.IsActiveNow ? "bg-success" : item.IsUpcoming ? "bg-primary" : "bg-secondary")">@item.StatusLabel</span>
                            </div>
                            <p class="small mb-2">@item.Message</p>
                            <p class="small text-muted mb-1"><strong>Audience:</strong> @item.AudienceLabel</p>
                            <p class="small text-muted mb-0">@item.StartDateTime.ToString("MMM d, yyyy h:mm tt") - @item.EndDateTime.ToString("MMM d, yyyy h:mm tt")</p>
                        </div>
                    }
                }
                else
                {
                    <div class="sa-empty-state py-4">
                        <i class="bi bi-megaphone"></i>
                        <h6>No announcements yet</h6>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            toggleAnnouncementDepartment();
        });
    </script>
}
