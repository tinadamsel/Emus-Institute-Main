@model IEnumerable<Core.ViewModels.TextbookViewModel>
@using static Core.DB.ECollegeEnums

@{
    ViewData["Title"] = "Textbooks";
    Layout = "~/Views/Shared/_StaffDashboardLayout.cshtml";
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Department Textbooks</h1>
            <p class="sa-page-sub">Upload and track textbooks for @ViewBag.DepartmentName.</p>
        </div>
        <div>
            <a asp-controller="AcademicStaff" asp-action="CreateTextbook" class="btn btn-outline-success">
                <i class="bi bi-plus-lg"></i> Create Textbook
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="sa-list-card sa-table-wrap table-responsive">
                <table class="table table-hover table-striped custom-table" id="dataTable">
                    <thead>
                        <tr>
                            <th>S/N</th>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Session</th>
                            <th>Department</th>
                            <th>Date Created</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @{ var sn = 1; }
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td>@sn</td>
                                    <td>@book.Name</td>
                                    <td>@book.TextbookCode</td>
                                    <td>@book.TextbookForEachSession</td>
                                    <td>@book.DepartmentName</td>
                                    <td>@book.DateCreated.ToString("D")</td>
                                    <td>
                                        @if (book.Status == TextbookApprovalStatus.Approved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (book.Status == TextbookApprovalStatus.Declined)
                                        {
                                            <span class="badge bg-danger">Declined</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(book.FilePath))
                                        {
                                            <a class="btn btn-outline-success btn-sm" asp-controller="AcademicStaff" asp-action="DownloadTextbook" asp-route-id="@book.Id">
                                                Download
                                            </a>
                                        }
                                    </td>
                                </tr>
                                sn++;
                            }
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="8">
                                    <div class="sa-empty-state">
                                        <i class="bi bi-book"></i>
                                        <h6>No textbooks yet</h6>
                                        <p>Create a textbook to share learning materials with your department.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>
        </div>
    </div>
</main>
