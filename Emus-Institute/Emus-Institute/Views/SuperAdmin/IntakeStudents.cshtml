@model IEnumerable<Core.ViewModels.ApplicationUserViewModel>

@{
    ViewData["Title"] = "Intake Students";
    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Intake Students</h1>
            <p class="sa-page-sub">Students who registered through Intake Hub. They are auto-approved and can log in immediately.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="sa-list-card sa-table-wrap table-responsive">
                <table class="table table-hover table-striped custom-table" id="dataTable">
                    <thead>
                        <tr>
                            <th>S/N</th>
                            <th>Name</th>
                            <th>Date Registered</th>
                            <th>Department</th>
                            <th>State</th>
                            <th>Country</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>StudentID</th>
                            <th>Textbook/Data</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td></td>
                                    <td>@user.FullName</td>
                                    <td>@user.DateRegistered.ToString("D")</td>
                                    <td>@user.DepartmentName</td>
                                    <td>@user.State</td>
                                    <td>@user.Country</td>
                                    <td>@user.Email</td>
                                    <td>@user.Phonenumber</td>
                                    <td>@user.StudentId</td>
                                    <td>
                                        <span class="badge @(user.HasPaidIntakeTextbook ? "bg-success" : "bg-warning text-dark")">
                                            @(user.HasPaidIntakeTextbook ? "Paid" : "Pending")
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <div class="sa-row-actions my-2">
                                            @if (user?.IsSuspended == true)
                                            {
                                                <button class="btn btn-outline-success rounded-pill mx-1 disabled">Suspended</button>
                                            }
                                            else
                                            {
                                                <a class="btn btn-outline-success mx-1" data-toggle="modal" data-target="#suspend_user" onclick="userToSuspend('@user.Id')">Suspend</a>
                                            }
                                            <a class="btn btn-outline-success mx-1" data-toggle="modal" data-target="#deactivate_user" onclick="userToDeactivate('@user.Id')">Deactivate</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="11">
                                    <div class="sa-empty-state">
                                        <i class="bi bi-people"></i>
                                        <h6>No intake students yet</h6>
                                        <p>Intake Hub registrations will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>
        </div>
    </div>
</main>

<div class="modal fade sa-modal" id="suspend_user" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><b>Suspend User</b></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-center">Are you sure you want to suspend?</p>
                <div class="modal-btn delete-action">
                    <div class="row m-auto">
                        <input class="form-control" hidden type="text" id="user_id">
                        <div class="col-6">
                            <a class="btn btn-outline-success rounded-pill p-2 d-block" onclick="SuspendUser()">Suspend</a>
                        </div>
                        <div class="col-6">
                            <a data-bs-dismiss="modal" class="btn btn-outline-success rounded-pill p-2 d-block">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade sa-modal" id="deactivate_user" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><b>Deactivate User</b></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-center">Are you sure you want to deactivate?</p>
                <div class="modal-btn delete-action">
                    <div class="row m-auto">
                        <input class="form-control" hidden type="text" id="user_id">
                        <div class="col-6">
                            <a class="btn btn-outline-success rounded-pill p-2 d-block" onclick="DeactivateUser()">Deactivate</a>
                        </div>
                        <div class="col-6">
                            <a data-bs-dismiss="modal" class="btn btn-outline-success rounded-pill p-2 d-block">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
