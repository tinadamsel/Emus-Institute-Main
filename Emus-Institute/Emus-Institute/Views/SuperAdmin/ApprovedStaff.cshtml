@model IEnumerable<Core.ViewModels.StaffDocumentationViewModel>
@using static Core.DB.ECollegeEnums

@{
    ViewData["Title"] = "Approved Staff";
    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";
    var departments = ViewBag.Departments as IEnumerable<Core.ViewModels.DepartmentViewModel>;
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Approved Staff</h1>
            <p class="sa-page-sub">Manage active staff accounts, documents, and actions.</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="sa-list-card sa-table-wrap table-responsive">
                <table class="table table-hover table-striped custom-table" id="dataTable">
                    <thead>
                        <tr>
                            @*<th> S/N</th>*@
                            <th> Name </th>
                            <th> Email </th>
                            <th> Password </th>
                            <th> Staff Position </th>
                            <th> Department Chosen </th>
                            <th> Cover Letter </th>
                            <th> Resume </th>
                            <th> ID </th>
                            <th> Date Applied</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @foreach (var staff in Model)
                            {
                                <tr style="font-size:small;">
                                    @*<td></td>*@
                                    <td>@staff.Name </td>
                                    <td>@staff.Email </td>
                                    <td>@staff.Password </td>
                                    <td>@staff?.StaffPosition </td>

                                    @if (staff?.StaffPosition == Core.DB.ECollegeEnums.StaffPosition.AcademicStaff)
                                    {
                                        <td> @staff.DepartmentName </td>
                                    }
                                    else
                                    {
                                        <td> None </td>
                                    }
                                    <td>
                                        <a class="btn btn-outline-success" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#coverLetter" onclick="viewCoverLetter('@staff.Id')">
                                            View
                                        </a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-success" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#resume" onclick="viewResume('@staff.Resume')">
                                            View
                                        </a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-success" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#IDimage" onclick="viewIDImage('@staff.Identification')">
                                            <i class="bi bi-eye-fill" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    <td>@staff?.DateCreated.ToString("D") </td>
                                    <td class="text-center">
                                        <div class="sa-row-actions sa-row-actions-nowrap my-2 justify-content-center">
                                            @if (staff?.IsSuspended == true)
                                            {
                                                <button class="btn btn-outline-success rounded-pill disabled">
                                                    Suspended
                                                </button>
                                            }
                                            else
                                            {
                                                <a class="btn btn-outline-success rounded-pill" data-toggle="modal" data-target="#suspend_user" onclick="userToSuspend('@staff.UserId')">
                                                    Suspend
                                                </a>
                                            }
                                            @if (staff.Deactivated)
                                            {
                                                <button class="btn btn-outline-success rounded-pill disabled">
                                                    Deactivated
                                                </button>
                                            }
                                            else
                                            {
                                                <a class="btn btn-outline-success rounded-pill" data-toggle="modal" data-target="#deactivate_user" onclick="userToDeactivate('@staff.UserId')">
                                                    Deactivate
                                                </a>
                                            }
                                            <a class="btn btn-outline-success rounded-pill" onclick="getRefBonus('@staff.Id')">
                                                Referral Bonus
                                            </a>
                                            <a class="btn btn-outline-primary rounded-pill reassign-role-btn"
                                               data-staff-id="@staff.Id"
                                               data-staff-position="@((int)staff.StaffPosition)"
                                               data-department-id="@(staff.DepartmentId ?? 0)"
                                               data-staff-name="@staff.Name">
                                                Reassign Role
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="9">
                                    <div class="sa-empty-state">
                                        <i class="bi bi-person-badge"></i>
                                        <h6>No approved staff yet</h6>
                                        <p>Approved staff records will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }

                </table>
            </div>
        </div>
    </div>
</main><!-- End #main -->

<!-- Reassign Role Modal -->
<div class="modal fade sa-modal" id="reassign_staff_role_modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><b>Reassign Staff Role</b></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="reassign_staff_id" />
                <p class="mb-3">Staff: <strong id="reassign_staff_name"></strong></p>
                <div class="mb-3">
                    <label for="reassign_staff_position" class="form-label">New Role</label>
                    <select class="form-select" id="reassign_staff_position" onchange="toggleReassignDepartmentField()">
                        @foreach (StaffPosition position in Enum.GetValues(typeof(StaffPosition)))
                        {
                            <option value="@((int)position)">@position</option>
                        }
                    </select>
                </div>
                <div class="mb-3" id="reassign_department_group" style="display:none;">
                    <label for="reassign_department_id" class="form-label">Department</label>
                    <select class="form-select" id="reassign_department_id">
                        <option value="">Select department</option>
                        @if (departments != null)
                        {
                            foreach (var dept in departments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="reassign_staff_role_btn" onclick="reassignStaffRole()">Save Role</button>
            </div>
        </div>
    </div>
</div>

<!-- cover letter modal -->
<div class="modal fade sa-modal" id="coverLetter" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> <b> View Cover Letter </b> </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-lg-12">
                        <textarea rows="8" cols="5" class="form-control" type="text" id="viewCoverLetter" disabled> </textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ID modal -->
<div class="modal fade sa-modal" id="IDimage" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> <b> Valid Identity </b> </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-lg-12 m-auto">
                        <img src="" height="100%" width="100%" class="rounded" alt="img" id="ImageId">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- resume modal -->
<div class="modal fade sa-modal" id="resume" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> <b> Resume </b> </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-lg-12 m-auto">
                        @* <img src="" height="100%" width="100%" class="rounded" alt="img" id="ImageId"> *@
                        <iframe id="resumePdfViewer" style="width:100%; height:400px;"></iframe>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- suspend Modal -->
<div class="modal fade sa-modal" id="suspend_user" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> <b> Suspend User </b> </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-center">Are you sure you want to suspend?</p>
                <div class="modal-btn delete-action">
                    <div class="row m-auto">
                        <input class="form-control" hidden type="text" id="user_id">
                        <div class="col-6">
                            <a class="btn btn-outline-success rounded-pill p-2 d-block" onclick="SuspendUser()">Suspend</a>
                        </div>
                        <div class="col-6">
                            <a data-bs-dismiss="modal" class="btn btn-outline-success rounded-pill p-2 d-block">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /suspend Modal -->
<!-- Deactivate Modal -->
<div class="modal fade sa-modal" id="deactivate_user" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> <b> Deactivate User </b> </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-center">Are you sure you want to deactivate?</p>
                <div class="modal-btn delete-action">
                    <div class="row m-auto">
                        <input class="form-control" hidden type="text" id="user_id">
                        <div class="col-6">
                            <a class="btn btn-outline-success rounded-pill p-2 d-block" onclick="DeactivateUser()">Deactivate</a>
                        </div>
                        <div class="col-6">
                            <a data-bs-dismiss="modal" class="btn btn-outline-success rounded-pill p-2 d-block">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Deactivate Modal -->
