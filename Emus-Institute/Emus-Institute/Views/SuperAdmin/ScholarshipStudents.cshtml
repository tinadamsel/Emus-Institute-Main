@model IEnumerable<Core.ViewModels.ApplicationUserViewModel>



@{

    ViewData["Title"] = "Student Scholarship";

    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";

}



<main id="main" class="main">

    <div class="sa-page-header">

        <div>

            <h1 class="sa-page-title">Student Scholarship</h1>

            <p class="sa-page-sub">Review pending scholarship applications and share the registration link.</p>

        </div>

        <div class="sa-page-actions">

            <button type="button" class="btn btn-outline-success" onclick="copyScholarshipRegistrationLink()">

                <i class="bi bi-link-45deg"></i> Copy scholarship registration link

            </button>

        </div>

    </div>



    <div class="row">

        <div class="col-md-12">

            <div class="sa-list-card sa-table-wrap table-responsive">

                <table class="table table-hover table-striped custom-table" id="dataTable">

                    <thead>

                        <tr>

                            <th>S/N</th>

                            <th>Name</th>

                            <th>Date Registered</th>

                            <th>Department</th>

                            <th>Scholarship Value</th>

                            <th>State</th>

                            <th>Country</th>

                            <th>Current Session</th>

                            <th>Academic Level</th>

                            <th>Email</th>

                            <th>Phone Number</th>

                            <th>Student ID</th>

                            <th class="text-center">Action</th>

                        </tr>

                    </thead>

                    @if (Model != null && Model.Any())

                    {

                        <tbody>

                            @foreach (var user in Model)

                            {

                                <tr>

                                    <td></td>

                                    <td>@user.FullName</td>

                                    <td>@user.DateRegistered.ToString("D")</td>

                                    <td>@user.DepartmentName</td>

                                    <td>

                                        @if (user.ScholarshipAmount.HasValue)

                                        {

                                            @($"€{user.ScholarshipAmount.Value:N2}")

                                        }

                                        else

                                        {

                                            <span class="text-muted">—</span>

                                        }

                                    </td>

                                    <td>@user.State</td>

                                    <td>@user.Country</td>

                                    <td>@user.CurrentSession</td>

                                    <td>@user.AcademicLevel</td>

                                    <td>@user.Email</td>

                                    <td>@user.Phonenumber</td>

                                    <td>@user.StudentId</td>

                                    <td class="text-right">

                                        <div class="sa-row-actions my-2">

                                            <a class="btn btn-outline-success mx-1" onclick="approveScholarshipStudent('@user.Id')">

                                                Approve

                                            </a>

                                            <a class="btn btn-outline-success mx-1" onclick="declineScholarshipStudent('@user.Id')">

                                                Decline

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    }

                    else

                    {

                        <tbody>

                            <tr>

                                <td colspan="13">

                                    <div class="sa-empty-state">

                                        <i class="bi bi-award"></i>

                                        <h6>No pending scholarship students</h6>

                                        <p>Share the scholarship registration link for students to apply.</p>

                                    </div>

                                </td>

                            </tr>

                        </tbody>

                    }

                </table>

            </div>

        </div>

    </div>

</main>


