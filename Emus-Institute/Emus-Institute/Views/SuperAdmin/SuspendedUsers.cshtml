@model IEnumerable<Core.ViewModels.SuspensionViewModel>

@{
    ViewData["Title"] = "Suspended Users";
    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Suspended Users</h1>
            <p class="sa-page-sub">Review suspensions and restore users when necessary.</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="sa-list-card sa-table-wrap table-responsive">
                <table class="table table-hover table-striped custom-table" id="dataTable">
                    <thead>
                        <tr>
                            <th> S/N</th>
                            <th> Name </th>
                            <th> Date Suspended </th>
                            <th> Reason </th>
                            <th> Duration </th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @foreach (var suspend in Model)
                            {
                                <tr style="font-size:small;">
                                    <td></td>
                                    <td>@suspend.Name </td>
                                    <td>@suspend.DateSuspended.ToString("D") </td>
                                    <td>@suspend.SuspensionReason </td>
                                    <td>@suspend.SuspensionDuration </td>
                                    <td class="text-center">
                                        <div class="sa-row-actions my-2">
                                            <a class="btn btn-outline-success rounded-pill mx-1" onclick="RemoveSuspension('@suspend.Id')">
                                                Remove Suspension
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="6">
                                    <div class="sa-empty-state">
                                        <i class="bi bi-shield-check"></i>
                                        <h6>No suspended users</h6>
                                        <p>All users are currently active.</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }

                </table>
            </div>
        </div>
    </div>
</main><!-- End #main -->
