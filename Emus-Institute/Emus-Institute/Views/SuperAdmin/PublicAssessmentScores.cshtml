@model IEnumerable<Core.ViewModels.CbtAttemptViewModel>
@{
    var test = ViewBag.Test as Core.ViewModels.CbtTestViewModel;
    ViewData["Title"] = "Assessment Scores";
    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";
    ViewBag.TestId = test?.Id;
}

<main id="main" class="main">
    <partial name="_PublicAssessmentNav" />

    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Assessment Scores</h1>
            <p class="sa-page-sub">@test?.Title · Submitted attempts only</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="sa-list-card sa-table-wrap">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Email</th>
                        <th>Score</th>
                        <th>Result</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>@attempt.StudentName</td>
                            <td>@attempt.StudentEmail</td>
                            <td>@attempt.Score / @attempt.TotalMarks</td>
                            <td>
                                <span class="badge @(attempt.Passed ? "bg-success" : "bg-danger")">
                                    @(attempt.Passed ? "Passed" : "Failed")
                                </span>
                                @if (attempt.AutoSubmitted)
                                {
                                    <span class="badge bg-warning text-dark">Auto-submitted</span>
                                }
                            </td>
                            <td>@attempt.SubmittedAt?.ToString("MMM d, yyyy h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="sa-list-card">
            <div class="sa-empty-state py-5">
                <i class="bi bi-mortarboard"></i>
                <h6>No submissions yet</h6>
                <p>Scores will appear here after candidates complete the assessment.</p>
            </div>
        </div>
    }
</main>
