@model Core.ViewModels.CbtAnalyticsViewModel
@{
    ViewData["Title"] = "Assessment Analytics";
    Layout = "~/Views/Shared/_SuperAdminDashboardLayout.cshtml";
    ViewBag.TestId = Model.CbtTestId;
}

<main id="main" class="main">
    <partial name="_PublicAssessmentNav" />

    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Assessment Analytics</h1>
            <p class="sa-page-sub">@Model.TestTitle</p>
        </div>
        <a asp-action="PublicAssessmentScores" asp-route-id="@Model.CbtTestId" class="btn btn-outline-secondary">View All Scores</a>
    </div>

    <div class="sa-stats-grid mb-4">
        <div class="sa-stat-card" data-accent="blue">
            <p class="sa-stat-label">Total Attempts</p>
            <p class="sa-stat-value">@Model.TotalAttempts</p>
        </div>
        <div class="sa-stat-card" data-accent="green">
            <p class="sa-stat-label">Average Score</p>
            <p class="sa-stat-value">@Model.AverageScore</p>
        </div>
        <div class="sa-stat-card" data-accent="teal">
            <p class="sa-stat-label">Pass Rate</p>
            <p class="sa-stat-value">@Model.PassRate%</p>
        </div>
        <div class="sa-stat-card" data-accent="orange">
            <p class="sa-stat-label">Fail Rate</p>
            <p class="sa-stat-value">@Model.FailRate%</p>
        </div>
    </div>
</main>
