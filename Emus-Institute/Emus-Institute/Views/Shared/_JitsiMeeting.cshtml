@model Core.ViewModels.LiveSessionViewModel

<div class="live-session-meta mb-2 px-1">
    <h4 class="mb-1">@Model.RoomName</h4>
    @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
    {
        <p class="text-muted small mb-0">@Model.WelcomeMessage</p>
    }
</div>
<div id="jitsi-container" class="live-session-frame"></div>

<script src="https://meet.jit.si/external_api.js"></script>
<script>
    (function () {
        var domain = 'meet.jit.si';
        var displayName = @System.Text.Json.JsonSerializer.Serialize(Model.JitsiDisplayName ?? "Participant");
        @if (Model.IsHost)
        {
            <text>displayName += ' (Host)';</text>
        }

        var options = {
            roomName: @System.Text.Json.JsonSerializer.Serialize(Model.RoomCode),
            width: '100%',
            height: '100%',
            parentNode: document.querySelector('#jitsi-container'),
            userInfo: {
                displayName: displayName
            },
            configOverwrite: {
                startWithAudioMuted: true,
                startWithVideoMuted: false,
                prejoinPageEnabled: false
            },
            interfaceConfigOverwrite: {
                TOOLBAR_BUTTONS: [
                    'microphone', 'camera', 'closedcaptions', 'desktop', 'fullscreen',
                    'fodeviceselection', 'hangup', 'chat', 'raisehand', 'tileview'
                ]
            }
        };

        new JitsiMeetExternalAPI(domain, options);
    })();
</script>
