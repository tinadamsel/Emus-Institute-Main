@model Core.ViewModels.LiveSessionViewModel
@{
    var displayName = Model.JitsiDisplayName ?? "Participant";
    if (Model.IsHost && !displayName.Contains("(Host)", StringComparison.OrdinalIgnoreCase))
    {
        displayName += " (Host)";
    }

    var joinUrl = Model.JitsiJoinUrl;
    if (string.IsNullOrWhiteSpace(joinUrl))
    {
        joinUrl = Logic.Helpers.LiveSessionHelper.BuildJitsiJoinUrl(Model.RoomCode, displayName, Model.IsHost, Model.Id);
    }
}

<div class="live-session-meta mb-3 px-1">
    <h4 class="mb-1">@Model.RoomName</h4>
    @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
    {
        <p class="small mb-0">@Model.WelcomeMessage</p>
    }
</div>

<div class="live-session-join-card">
    <p class="live-session-kicker">EMUS INSTITUTE LIVE CLASS</p>
    <h2>Ready to join?</h2>
    <p class="mb-4">Check your camera and microphone, then enter the class. Use a stable internet connection.</p>

    <div class="live-session-user">
        <strong>@displayName</strong>
        <span>@(Model.IsHost ? "You are the host for this session." : "You will join as a student.")</span>
    </div>

    <p class="small text-muted mb-4">
        Mic and camera start off. You can turn them on after you enter the room.
        The first person in the room may be asked to sign in on Jitsi (Google, GitHub, or Facebook). After that, everyone else can join.
    </p>

    <a class="btn btn-warning btn-lg w-100" href="@joinUrl" target="_blank" rel="noopener noreferrer">
        Join Class
    </a>
    <p class="small text-center mt-3 mb-0">The class opens in a new tab.</p>
</div>
