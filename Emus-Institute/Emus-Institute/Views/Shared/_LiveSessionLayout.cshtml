<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Emus Institute</title>
    <link href="~/assets/img/logo-main-fav.jpg" rel="icon">
    <link href="~/asset/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/asset/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/superadmin-dashboard.css" rel="stylesheet" asp-append-version="true" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            background: #0f172a;
        }

        .live-session-shell {
            height: 100vh;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 1rem;
            box-sizing: border-box;
        }

        .live-session-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            color: #fff;
        }

        .live-session-topbar a {
            color: #fff;
            text-decoration: none;
        }

        .live-session-meta h4 {
            color: #fff;
            margin-bottom: 0.25rem;
        }

        .live-session-meta p {
            color: #fff;
        }

        .live-session-body {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .live-session-frame {
            flex: 1 1 auto;
            position: relative;
            width: 100%;
            min-height: 560px;
            height: calc(100vh - 150px);
            border-radius: 12px;
            overflow: hidden;
            background: #111827;
        }

        .live-session-frame iframe {
            display: block;
            width: 100% !important;
            height: 100% !important;
            min-height: 560px;
            border: 0;
            background: #111827;
        }

        .live-session-join-card {
            max-width: 520px;
            margin: 3rem auto;
            background: #1e293b;
            color: #e5e7eb;
            border-radius: 16px;
            padding: 2rem;
        }

        .live-session-kicker {
            color: #f97316;
            letter-spacing: 0.08em;
            font-size: 0.75rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        .live-session-join-card h2 {
            color: #fff;
            margin-bottom: 0.75rem;
        }

        .live-session-user {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            background: #0f172a;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
        }

        .live-session-user span {
            color: #94a3b8;
            font-size: 0.875rem;
        }

        .live-session-status {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e5e7eb;
            font-size: 1rem;
            padding: 1.5rem;
            text-align: center;
            pointer-events: none;
        }

        .live-session-status.is-error {
            color: #fecaca;
            pointer-events: auto;
        }
    </style>
</head>
<body>
    <div class="live-session-shell">
        <div class="live-session-topbar">
            <a href="@ViewBag.BackUrl"><i class="bi bi-arrow-left"></i> @ViewBag.BackLabel</a>
            <span class="small">Powered by Jitsi Meet</span>
        </div>
        <div class="live-session-body">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
