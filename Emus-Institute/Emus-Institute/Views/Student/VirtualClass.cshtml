@model IEnumerable<Core.ViewModels.LiveSessionViewModel>

@{
    ViewData["Title"] = "Virtual Class";
    Layout = "~/Views/Shared/_StudentDashboardLayout.cshtml";
}

<main id="main" class="main">
    <div class="sa-page-header">
        <div>
            <h1 class="sa-page-title">Virtual Class</h1>
            <p class="sa-page-sub">Join live classes for your department. Attend Class is available only during the scheduled session time.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                var badgeClass = session.IsActiveNow ? "bg-success" : session.IsUpcoming ? "bg-primary" : "bg-secondary";
                <div class="col-lg-4 col-md-6">
                    <div class="sa-list-card h-100 p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0">@session.RoomName</h5>
                            <span class="badge @badgeClass">@session.StatusLabel</span>
                        </div>
                        <p class="small text-muted mb-2">@session.ScheduleDisplay</p>
                        @if (!string.IsNullOrWhiteSpace(session.StaffName))
                        {
                            <p class="small mb-2">Lecturer: @session.StaffName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.WelcomeMessage))
                        {
                            <p class="small flex-grow-1">@session.WelcomeMessage</p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }
                        <div class="mt-3">
                            @if (session.CanJoin)
                            {
                                <a asp-controller="Student" asp-action="JoinLiveSession" asp-route-id="@session.Id"
                                   class="btn btn-outline-success w-100">Attend Class</a>
                            }
                            else if (session.IsUpcoming)
                            {
                                <button type="button" class="btn btn-outline-secondary w-100" disabled>Not started yet</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary w-100" disabled>Session ended</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="sa-list-card">
            <div class="sa-empty-state py-5">
                <i class="bi bi-camera-video"></i>
                <h6>No virtual classes scheduled</h6>
                <p>When your department schedules a live class, it will appear here.</p>
            </div>
        </div>
    }
</main>
